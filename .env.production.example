# Copy to .env.production on the server, replace every CHANGE_ME value,
# then protect it with: chmod 600 .env.production
SITE_ADDRESS=ai.aromazenind.com
APP_DATA_DIR=/srv/aromazen

# Generate independently with: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_48_RANDOM_CHARACTERS
BACKUP_ENCRYPTION_PASSWORD=CHANGE_ME_LONG_RANDOM_BACKUP_PASSWORD

# Used only when the very first empty database starts. After the first login,
# clear BOOTSTRAP_OWNER_PASSWORD and redeploy; the existing owner remains.
BOOTSTRAP_OWNER_EMAIL=owner@aromazenind.com
BOOTSTRAP_OWNER_PASSWORD=CHANGE_ME_MINIMUM_12_CHARACTERS
BOOTSTRAP_OWNER_NAME="AROMAZEN Super Admin"

JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
LOGIN_RATE_LIMIT_PER_MINUTE=10

# At least one AI provider is required for complete Regulatory ingredient research.
AI_DEFAULT_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional free EPA CompTox key: request one from ccte_api@epa.gov.
EPA_COMPTOX_API_KEY=
AI_MAX_OUTPUT_TOKENS=12000

# Use a Zoho app password, not the mailbox's normal password.
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=587
ZOHO_SMTP_SECURITY=starttls
ZOHO_SMTP_USERNAME=
ZOHO_SMTP_PASSWORD=
ZOHO_FROM_EMAIL=
ZOHO_FROM_NAME="AROMAZEN INDIA"
# Optional JSON map for additional department mailboxes. Keep credentials only in the protected server environment.
ZOHO_DEPARTMENT_ACCOUNTS_JSON=

# Optional private S3-compatible bucket used by backup.sh.
# Leave empty during low-cost testing to retain encrypted database backups locally only.
BACKUP_BUCKET=
AWS_DEFAULT_REGION=ap-south-1
LOCAL_BACKUP_DAYS=7
