APP_NAME=AROMAZEN AI API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://aromazen:aromazen_dev_password@postgres:5432/aromazen_ai
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
JWT_SECRET_KEY=replace_with_a_long_random_private_signing_key
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false
BOOTSTRAP_OWNER_EMAIL=owner@aromazen.com
BOOTSTRAP_OWNER_PASSWORD=replace_with_a_strong_temporary_password
BOOTSTRAP_OWNER_NAME=AROMAZEN Owner
AI_MAX_OUTPUT_TOKENS=12000
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USERNAME=
ZOHO_SMTP_PASSWORD=
ZOHO_FROM_EMAIL=
ZOHO_FROM_NAME=AROMAZEN INDIA
